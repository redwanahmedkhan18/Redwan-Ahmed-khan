# ---- Core ----
ENVIRONMENT=development            # development | testing | production
SITE_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# ---- Database ----
# Production: postgresql+psycopg://user:password@host:5432/portfolio
# Local dev fallback: sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio
DB_ECHO=false

# ---- Auth (NEVER commit real secrets) ----
SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300

# Bootstrap super admin (seed script only)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_CONTACT_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_MINUTE=10

# ---- SMTP (optional; notifications logged when unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
NOTIFY_EMAIL=

# ---- Object storage (optional; local disk when STORAGE_BACKEND=local) ----
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ---- Redis (optional cache/rate-limit) ----
REDIS_URL=

# ---- Uploads ----
MAX_UPLOAD_MB=10

# ---- Docs (disable in production if desired) ----
ENABLE_OPENAPI_DOCS=true
