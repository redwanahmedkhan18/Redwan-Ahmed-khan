# Root environment — copy to .env and fill in. NEVER commit .env.

# --- Deployment ---
ENVIRONMENT=development
SITE_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=portfolio
DATABASE_URL=postgresql+psycopg://portfolio:change-me-strong-password@localhost:5432/portfolio

# --- Secrets (generate strong random values) ---
SECRET_KEY=
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Bootstrap super admin (seed only) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# --- Object storage (optional; local disk default) ---
STORAGE_BACKEND=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379/0
